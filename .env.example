# FeeDesk AI — copy this file to ".env" and fill in YOUR sandbox values.
# Never commit the real .env (it is in .gitignore). Never hardcode secrets in code.

# --- Mode ---------------------------------------------------------------
# "mock" = local simulation: no PayPal account, no network, no real money.
# The desk works end to end with mock orders, mock payer approvals and
# HMAC-signed mock webhooks. This is the default way to run and demo it.
# "live" = real PayPal sandbox APIs (needs the credentials below).
PAYPAL_MODE=mock

# --- Live PayPal credentials (only needed when PAYPAL_MODE is not mock) --
# From your PayPal Developer sandbox app (README step 3):
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# "sandbox" during the whole hackathon build. Only "live" uses real money — do NOT use it.
PAYPAL_ENV=sandbox

# Created when you register the webhook in your PayPal app (build Slice 3):
PAYPAL_WEBHOOK_ID=

# --- Mock mode ------------------------------------------------------------
# Secret used to HMAC-sign mock webhook events. Only used in mock mode; it is
# NOT a PayPal credential and must never be used with real webhooks.
# Leave blank to use the built-in dev-only default.
MOCK_WEBHOOK_SECRET=

# --- AI explainer (optional enhancement) ----------------------------------
# Without a key, the rule-based explainer answers (always works, offline).
# With a key, the explainer tries the model first and falls back to the rules
# on any failure. Groq is tried first, then Gemini. Free tiers are enough.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Server port (optional, default 3000):
PORT=3000
